# ==============================================================================
# 风吟调度 (Fengyin Governor) - 数组动态解析调试/测试函数
# 文件: vtools/abort_util
# 作用: 供开发者调试 eval 解析配置数组字符串（如 "freq=(...)"）的独立验证辅助脚本
# ==============================================================================

# ------------------------------------------------------------------------------
# test_func: 模拟 parse_config 的底层解构逻辑，用于打印各模式参数值
# ------------------------------------------------------------------------------
test_func() {
    for tmp in "$@"
    do
        # 动态还原传入参数字符串中的数组声明 (如 eval "freq=(...)")
        eval $tmp
        # 打印数组整体引用
        echo $freq
        # 遍历 0(省电), 1(均衡), 2(性能), 3(极速) 对应的值并输出
        for num in 0 1 2 3
        do
            echo ${freq[$num]}
        done
    done
}
